{
  "name": "dityath-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "bun run check && astro build",
    "preview": "astro preview",
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "ci": "biome ci . && bun run check && astro build",
    "astro": "astro",
    "build:og": "bun scripts/build-og.mjs",
    "build:dionysus": "node scripts/build-dionysus.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "7.2.9",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@biomejs/biome": "2.5.15",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/three": "^0.185.4",
    "meshoptimizer": "^1.1.1",
    "sharp": "^0.34.4",
    "typescript": "^7.0.2"
  }
}
