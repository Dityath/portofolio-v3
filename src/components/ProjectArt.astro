---
import type { ProjectArt } from '../data/projects';

interface Props {
  art: ProjectArt;
  index: string;
}

const { art, index } = Astro.props;
const dots = `dots-${index}`;
---

<svg class="art" viewBox="0 0 480 360" fill="none" aria-hidden="true" focusable="false">
  {art === 'grid' && (
    <>
      <defs>
        <pattern id={dots} width="24" height="24" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1.5" fill="var(--border)" />
        </pattern>
      </defs>
      <g class="layer-back">
        <rect width="480" height="360" fill={`url(#${dots})`} />
      </g>
      <g class="layer-mid" stroke="var(--border-strong)">
        <line x1="120" y1="300" x2="260" y2="300" />
        <line x1="120" y1="300" x2="120" y2="160" />
        <path d="M260 300 A140 140 0 0 0 120 160" stroke="var(--text-2)" stroke-width="1.5" />
        <circle cx="120" cy="300" r="4" stroke="var(--text-2)" />
      </g>
      <g class="art-accent">
        <rect x="215.5" y="197.5" width="7" height="7" fill="var(--accent)" />
      </g>
    </>
  )}
  {art === 'rings' && (
    <>
      <g class="layer-back" stroke="var(--border)">
        <circle cx="240" cy="180" r="140" />
        <circle cx="240" cy="180" r="100" />
      </g>
      <g class="layer-mid" stroke="var(--border-strong)">
        <circle cx="240" cy="180" r="60" />
        <line x1="60" y1="320" x2="420" y2="40" />
        <path d="M146 145.8 A100 100 0 0 1 205.8 86" stroke="var(--text-2)" stroke-width="1.5" />
        <circle cx="240" cy="180" r="3" fill="var(--text-2)" />
      </g>
      <g class="art-accent">
        <circle cx="350.5" cy="94" r="5" fill="var(--accent)" />
      </g>
    </>
  )}
  {art === 'iso' && (
    <>
      <g class="layer-mid" stroke="var(--border)">
        <path d="M240 175 L276 196 L240 217 L204 196 Z" fill="var(--surface-2)" />
        <path d="M204 196 L240 217 L240 259 L204 238 Z" fill="var(--bg)" />
        <path d="M276 196 L240 217 L240 259 L276 238 Z" fill="var(--surface)" />
        <path d="M148 129 L184 150 L148 171 L112 150 Z" fill="var(--surface-2)" />
        <path d="M112 150 L148 171 L148 213 L112 192 Z" fill="var(--bg)" />
        <path d="M184 150 L148 171 L148 213 L184 192 Z" fill="var(--surface)" />
        <path d="M332 129 L368 150 L332 171 L296 150 Z" fill="var(--surface-2)" />
        <path d="M296 150 L332 171 L332 213 L296 192 Z" fill="var(--bg)" />
        <path d="M368 150 L332 171 L332 213 L368 192 Z" fill="var(--surface)" />
        <path d="M240 83 L276 104 L240 125 L204 104 Z" fill="var(--surface-2)" />
        <path d="M204 104 L240 125 L240 167 L204 146 Z" fill="var(--bg)" />
        <path d="M276 104 L240 125 L240 167 L276 146 Z" fill="var(--surface)" />
      </g>
      <g class="art-accent">
        <path d="M204 104 L240 83" stroke="var(--accent)" stroke-width="1.5" />
      </g>
    </>
  )}
  {art === 'pins' && (
    <>
      <g class="layer-back" stroke="var(--border)">
        <line x1="40" y1="70" x2="440" y2="70" />
        <line x1="40" y1="150" x2="440" y2="150" />
        <line x1="40" y1="240" x2="440" y2="240" />
        <line x1="40" y1="310" x2="440" y2="310" />
        <line x1="90" y1="30" x2="90" y2="330" />
        <line x1="190" y1="30" x2="190" y2="330" />
        <line x1="300" y1="30" x2="300" y2="330" />
        <line x1="400" y1="30" x2="400" y2="330" />
      </g>
      <g class="layer-mid" stroke="var(--border-strong)">
        <line x1="40" y1="110" x2="440" y2="190" />
        <line x1="190" y1="30" x2="300" y2="330" />
        <rect x="86" y="106" width="8" height="8" fill="var(--text-2)" stroke="none" />
        <rect x="186" y="236" width="8" height="8" fill="var(--text-2)" stroke="none" />
        <rect x="396" y="66" width="8" height="8" fill="var(--text-2)" stroke="none" />
        <rect x="396" y="306" width="8" height="8" fill="var(--text-2)" stroke="none" />
        <rect x="136" y="146" width="8" height="8" fill="var(--text-2)" stroke="none" />
      </g>
      <g class="art-accent">
        <circle cx="300" cy="150" r="18" stroke="var(--accent)" />
        <rect x="295" y="145" width="10" height="10" fill="var(--accent)" />
      </g>
    </>
  )}
  {art === 'flow' && (
    <>
      <g class="layer-back" stroke="var(--border-strong)">
        <rect x="30" y="130" width="72" height="100" />
        <rect x="150" y="60" width="72" height="100" />
        <rect x="150" y="210" width="72" height="100" />
        <rect x="378" y="130" width="72" height="100" />
        <line x1="40" y1="150" x2="92" y2="150" />
        <line x1="160" y1="80" x2="212" y2="80" />
        <line x1="160" y1="230" x2="212" y2="230" />
        <line x1="388" y1="150" x2="440" y2="150" />
      </g>
      <g class="layer-mid" stroke="var(--text-2)">
        <path d="M102 180 L126 180 L126 110 L150 110" />
        <path d="M102 180 L126 180 L126 260 L150 260" />
        <path d="M222 110 L250 110 L250 180 L270 180" />
        <path d="M222 260 L250 260 L250 180" />
        <path d="M342 180 L378 180" />
        <path d="M144 106 L150 110 L144 114" />
        <path d="M144 256 L150 260 L144 264" />
        <path d="M264 176 L270 180 L264 184" />
        <path d="M372 176 L378 180 L372 184" />
      </g>
      <g class="art-accent">
        <rect x="270" y="130" width="72" height="100" stroke="var(--accent)" />
        <line x1="280" y1="150" x2="332" y2="150" stroke="var(--accent)" />
        <rect x="280" y="198" width="52" height="20" fill="var(--accent)" />
      </g>
    </>
  )}
</svg>

<style>
  .art { width: 100%; height: auto; display: block; overflow: visible; }
</style>
