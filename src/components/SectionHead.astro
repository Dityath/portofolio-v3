---
interface Props {
  id: string;
  title: string;
  note?: string;
  as?: 'h1' | 'h2';
}

const { id, title, note, as: Tag = 'h2' } = Astro.props;
---

<header class="section-head" data-reveal>
  <Tag id={id}>{title}</Tag>
  <span class="rule" aria-hidden="true"></span>
  {note && <span class="note mono">{note}</span>}
</header>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    margin-bottom: var(--space-block);
  }
  .section-head :is(h1, h2) {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text);
  }
  .rule {
    flex: 1;
    align-self: center;
    height: 1px;
    background: var(--border);
  }
  .note { color: var(--muted); white-space: nowrap; }
  @media (max-width: 620px) {
    .note { display: none; }
  }
</style>
