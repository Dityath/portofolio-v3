---
/**
 * Shared arrow icon. Replaces the Unicode "→ ← ↗" glyphs.
 * Inherits colour via currentColor and sizes with the surrounding font (1em).
 */
interface Props {
  dir?: 'right' | 'left' | 'up-right';
  class?: string;
}

const { dir = 'right', class: className } = Astro.props;

const paths: Record<NonNullable<Props['dir']>, string> = {
  right: 'M2 8H13M9 4L13 8L9 12',
  left: 'M3 8H14M7 4L3 8L7 12',
  'up-right': 'M3 13L13 3M6 3H13V10',
};
---

<svg
  aria-hidden="true"
  focusable="false"
  width="1em"
  height="1em"
  viewBox="0 0 16 16"
  fill="none"
  class:list={['arrow', className]}
>
  <path
    d={paths[dir]}
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="square"
  />
</svg>

<style>
  .arrow {
    display: inline-block;
    vertical-align: -0.125em;
    flex: none;
  }
</style>
