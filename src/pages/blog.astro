---
import Arrow from '../components/Arrow.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHead from '../components/SectionHead.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMediumPosts, MEDIUM_PROFILE_URL } from '../lib/medium';

const { posts, failed } = await getMediumPosts();
const dateFormatter = new Intl.DateTimeFormat('en', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
---

<BaseLayout
  title="Writing — Ditya Athallah"
  description="Articles by Ditya Athallah on product, engineering, and delivery, published on Medium."
>
  <Header />
  <main id="main">
    <PageIntro title="Writing" lede="Notes on product, engineering, and delivery. Published on Medium." />

    <section class="section" aria-labelledby="posts-title">
      <div class="container">
        <SectionHead id="posts-title" title="Latest" />

        {posts.length ? (
          <ul class="post-list" role="list">
            {posts.map((post) => (
              <li data-reveal>
                <a class="post" href={post.url} target="_blank" rel="noopener noreferrer">
                  <span class="mono post-date">{post.publishedAt ? dateFormatter.format(post.publishedAt) : 'Medium'}</span>
                  <div class="post-copy">
                    <h3>{post.title}</h3>
                    {post.excerpt && <p>{post.excerpt}</p>}
                  </div>
                  <span class="post-arrow" aria-hidden="true"><Arrow dir="up-right" /></span>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="empty" data-reveal>
            <p>{failed ? 'Articles are published on Medium. The latest are on my profile.' : 'Nothing published yet.'}</p>
            <a class="link-arrow" href={MEDIUM_PROFILE_URL} target="_blank" rel="noopener noreferrer">
              View profile on Medium <span aria-hidden="true"><Arrow dir="up-right" /></span><span class="sr-only">(opens in a new tab)</span>
            </a>
          </div>
        )}

        {posts.length > 0 && (
          <p class="more">
            <a class="link-arrow" href={MEDIUM_PROFILE_URL} target="_blank" rel="noopener noreferrer">
              View profile on Medium <span aria-hidden="true"><Arrow dir="up-right" /></span><span class="sr-only">(opens in a new tab)</span>
            </a>
          </p>
        )}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .post-list { list-style: none; border-top: var(--hairline); }
  .post-list li { border-bottom: var(--hairline); }
  .post {
    display: grid;
    grid-template-columns: 2fr 8fr auto;
    gap: var(--col-gap);
    align-items: baseline;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    transition: background-color 0.25s var(--ease-out);
  }
  .post:hover { background: color-mix(in srgb, var(--surface) 70%, transparent); }
  .post-date { color: var(--muted); }
  h3 { max-width: 40ch; font-size: var(--step-2); font-weight: 600; line-height: 1.2; letter-spacing: -0.02em; overflow-wrap: anywhere; }
  .post-copy p {
    max-width: 65ch;
    margin-top: 0.6rem;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .post-arrow { display: inline-block; color: var(--accent); transition: transform 0.25s var(--ease-out); }
  .post:hover .post-arrow { transform: translate(3px, -3px); }
  .more { margin-top: 2rem; }
  .empty { max-width: 40rem; padding: 1.75rem; border: var(--hairline); }
  .empty p { margin-bottom: 1.25rem; color: var(--text-2); }

  /* LAYOUT_BREAKPOINT — see src/constants.ts */
  @media (max-width: 900px) {
    .post { grid-template-columns: 1fr auto; gap: 0.5rem 1rem; }
    .post-copy { grid-column: 1; grid-row: 2; }
    .post-arrow { grid-column: 2; grid-row: 1 / span 2; }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-arrow { transition: none; }
    .post:hover .post-arrow { transform: none; }
  }
</style>
